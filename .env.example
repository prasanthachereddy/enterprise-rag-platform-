APP_NAME=enterprise-rag-platform
APP_ENV=local
APP_LOG_LEVEL=INFO

# Chunking and upload limits (used from Phase 1)
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=10485760

# Local OpenSearch (used from Phase 2)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=enterprise-policy-chunks

# AWS Bedrock (used from Phase 2 and 3; leave as is for local-only work)
AWS_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Retrieval and answers (used from Phase 2 and 3)
RETRIEVAL_TOP_K=5
ANSWER_MODE=offline
# Local embeddings and retrieval (Phase 2)
LOCAL_EMBEDDING_URL=http://localhost:8080
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384
RETRIEVAL_CANDIDATES=20
RRF_K=60
# Answers (Phase 3)
MIN_QUERY_COVERAGE=0.5


